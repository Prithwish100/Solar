{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and cloud-synced preferences in SOLAR.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user UID."
        },
        "displayName": {
          "type": "string",
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "description": "User email address."
        },
        "avatarUrl": {
          "type": "string",
          "description": "User profile photo URL."
        },
        "preferredAudioQuality": {
          "type": "string",
          "enum": ["LOW", "NORMAL", "HIGH", "LOSSLESS"],
          "description": "Preferred streaming audio quality."
        },
        "amoledDarkTheme": {
          "type": "boolean",
          "description": "Whether deep black (#080808) AMOLED theme is active."
        },
        "ytMusicConnected": {
          "type": "boolean",
          "description": "Whether YouTube Music library import is connected."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "displayName", "preferredAudioQuality", "amoledDarkTheme", "ytMusicConnected", "createdAt", "updatedAt"]
    },
    "LikedSong": {
      "title": "LikedSong",
      "description": "A track favorited by the user and synchronized across devices.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID."
        },
        "trackId": {
          "type": "string",
          "description": "Unique track identifier."
        },
        "title": {
          "type": "string",
          "description": "Song title."
        },
        "artist": {
          "type": "string",
          "description": "Artist name."
        },
        "album": {
          "type": "string",
          "description": "Album title."
        },
        "artworkUrl": {
          "type": "string",
          "description": "Album cover URL."
        },
        "streamUrl": {
          "type": "string",
          "description": "Audio stream URL."
        },
        "durationMs": {
          "type": "integer",
          "description": "Duration in milliseconds."
        },
        "sourceProvider": {
          "type": "string",
          "description": "Music provider identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when liked."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": ["userId", "trackId", "title", "artist", "album", "artworkUrl", "streamUrl", "durationMs", "sourceProvider", "createdAt", "updatedAt"]
    },
    "CloudPlaylist": {
      "title": "CloudPlaylist",
      "description": "User-created or imported playlist synchronized in Firestore.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID."
        },
        "name": {
          "type": "string",
          "description": "Playlist title."
        },
        "description": {
          "type": "string",
          "description": "Playlist description."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether playlist is publicly shareable."
        },
        "trackCount": {
          "type": "integer",
          "description": "Number of tracks in the playlist."
        },
        "sourceOrigin": {
          "type": "string",
          "description": "Origin of the playlist (SOLAR, YOUTUBE_MUSIC, JIOSAAVN, M3U)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update."
        }
      },
      "required": ["userId", "name", "description", "isPublic", "trackCount", "sourceOrigin", "createdAt", "updatedAt"]
    },
    "ListeningHistory": {
      "title": "ListeningHistory",
      "description": "Cloud-synced listening history record.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID."
        },
        "trackId": {
          "type": "string",
          "description": "Track identifier."
        },
        "title": {
          "type": "string",
          "description": "Track title."
        },
        "artist": {
          "type": "string",
          "description": "Artist name."
        },
        "durationMs": {
          "type": "integer",
          "description": "Track duration in ms."
        },
        "sourceProvider": {
          "type": "string",
          "description": "Provider source."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when played."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": ["userId", "trackId", "title", "artist", "durationMs", "sourceProvider", "createdAt", "updatedAt"]
    },
    "AdminBroadcast": {
      "title": "AdminBroadcast",
      "description": "Real-time notification or OTA app update pushed from the SOLAR Web Admin Panel to users.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "Authenticated UID of the admin who sent the broadcast."
        },
        "senderEmail": {
          "type": "string",
          "description": "Email of the admin sender."
        },
        "type": {
          "type": "string",
          "enum": ["NOTIFICATION", "APP_UPDATE"],
          "description": "Whether this broadcast is a user notification or an app update announcement."
        },
        "title": {
          "type": "string",
          "description": "Notification or update headline."
        },
        "message": {
          "type": "string",
          "description": "Notification body or release notes."
        },
        "targetVersion": {
          "type": "string",
          "description": "App version string for APP_UPDATE broadcasts (e.g. 1.7)."
        },
        "actionUrl": {
          "type": "string",
          "description": "Optional download link or deep action URL."
        },
        "isMandatory": {
          "type": "boolean",
          "description": "Whether the app update is marked mandatory."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when broadcast was sent."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when broadcast was last updated."
        }
      },
      "required": ["senderId", "type", "title", "message", "targetVersion", "actionUrl", "isMandatory", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document and cloud preferences."
    },
    "/users/{userId}/liked_songs/{songId}": {
      "schema": { "$ref": "#/entities/LikedSong" },
      "description": "User's cloud-synced liked songs."
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/CloudPlaylist" },
      "description": "User's cloud-synced playlists."
    },
    "/users/{userId}/listening_history/{historyId}": {
      "schema": { "$ref": "#/entities/ListeningHistory" },
      "description": "User's cloud-synced listening history."
    },
    "/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/AdminBroadcast" },
      "description": "Global admin notifications and app updates pushed from the Web Admin Panel."
    }
  }
}
